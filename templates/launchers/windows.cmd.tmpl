@echo off
rem Template only. Review paths and the Hermes executable before installation.
rem This launcher accepts no arguments. It is not an operating-system sandbox.
rem Windows does not clear the full user environment. Review inherited values.

setlocal

if not "%~1"=="" (
  echo This launcher does not accept arguments. 1>&2
  exit /b 64
)

set "PROFILE_HOME={{ABSOLUTE_HERMES_HOME}}"
set "SYNTHETIC_HOME=%PROFILE_HOME%\home"
set "HERMES_BIN={{ABSOLUTE_HERMES_BIN}}"

if not exist "%SYNTHETIC_HOME%" mkdir "%SYNTHETIC_HOME%"

set "HOME=%SYNTHETIC_HOME%"
set "HERMES_HOME=%PROFILE_HOME%"
set "PATH={{MINIMAL_PATH}}"

"%HERMES_BIN%" chat --cli
exit /b %ERRORLEVEL%
