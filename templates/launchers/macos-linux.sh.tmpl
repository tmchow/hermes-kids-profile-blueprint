#!/bin/sh
# Template only. Review paths and the Hermes executable before installation.
# This launcher accepts no arguments. It is not an operating-system sandbox.

set -eu

if [ "$#" -ne 0 ]; then
  printf '%s\n' "This launcher does not accept arguments." >&2
  exit 64
fi

PROFILE_HOME="{{ABSOLUTE_HERMES_HOME}}"
SYNTHETIC_HOME="$PROFILE_HOME/home"
HERMES_BIN="{{ABSOLUTE_HERMES_BIN}}"

mkdir -p "$SYNTHETIC_HOME"
chmod 700 "$PROFILE_HOME" "$SYNTHETIC_HOME"

exec env -i \
  HOME="$SYNTHETIC_HOME" \
  HERMES_HOME="$PROFILE_HOME" \
  PATH="{{MINIMAL_PATH}}" \
  "$HERMES_BIN" chat --cli
