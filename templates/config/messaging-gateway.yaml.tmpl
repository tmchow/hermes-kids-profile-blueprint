# Reference fragment only. Verify the platform and key paths against the
# installed Hermes version before use.
# This repository does not ship the required pre-Hermes command, scope, and
# media boundary. This fragment cannot produce a positive readiness result by
# itself.
#
# Baseline scope: direct messages only. Do not enable groups, channels, forums,
# or threads under this fragment. Many adapters use separate scope-specific
# keys. An unverified scope is a readiness failure.
#
# Required outcomes:
# - explicit child and parent sender allowlist
# - verified parent-only administrative allowlist
# - child absent from every administrative list
# - a tested identity-aware pre-Hermes command boundary admits child plain text
#   plus /help and /whoami, rejects every other child slash command before
#   Hermes receives it, and preserves the verified parent admin route
# - unauthorized direct messages ignored
# - child, parent, and unauthorized behavior tested through the real platform
# - a platform-specific or external boundary rejects all non-DM events before
#   they reach the profile, and that boundary is tested
#
# Do not assume that dm_policy, group_policy, or empty group allowlists are
# portable controls. For example, current Telegram allow_from entries apply to
# DMs, groups, and forums. Telegram needs a separate pre-Hermes DM-only boundary
# or it is unsupported for independent access under this blueprint.
#
# Native Hermes slash gating is defense in depth, not the required command
# boundary. At the pinned commit, /status and /context can bypass that gate
# during an active turn and expose session or runtime metadata. Test the
# external boundary while the agent is idle and while it is responding.
# The child session must also be unable to create or inherit pending update
# prompts, tool approvals, or slash-confirmation state. Pinned Hermes handles
# replies to those states before slash authorization. The approved clarify tool
# is separate and remains available.

gateway:
  stt:
    enabled: false
    echo_transcripts: false
  quick_commands: {}
  platforms:
    {{PLATFORM_KEY}}:
      extra:
        allow_from:
          - "{{CHILD_PLATFORM_ID}}"
          - "{{PARENT_PLATFORM_ID}}"
        allow_admin_from:
          - "{{PARENT_PLATFORM_ID}}"
        user_allowed_commands:
          - help
          - whoami
        group_allow_admin_from: []
        group_user_allowed_commands: []

# STT disabled here prevents automatic transcription. It does not reject files
# or stop native/auxiliary image routing. Add a tested adapter, proxy, or platform
# boundary that rejects image, voice, audio, video, and document input before
# Hermes receives or downloads it. If that is not possible, text-only readiness
# is FAIL.
