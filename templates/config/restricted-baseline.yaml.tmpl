# Reference fragment only. Verify every key against the installed Hermes version.
# Merge this intent into a new private deployment. Do not paste it into an adult profile.
# The exact platform list is deployment-specific. Resolve it at runtime.

security:
  inherit_global_auth: false
  allow_private_urls: false
  redact_secrets: true
  protected_instruction_files: true
  tirith_enabled: true
  tirith_fail_open: false
  allow_lazy_installs: false

plugins:
  enabled: []

mcp_servers: {}

# Explicit platform lists are the primary tool boundary. `no_mcp` is the
# current sentinel that prevents enabled MCP servers from being added.
# Replace PLATFORM_KEY with every enabled child-facing platform.
platform_toolsets:
  {{PLATFORM_KEY}}:
    - clarify
    - no_mcp

agent:
  max_turns: {{MAX_TURNS}}
  disabled_toolsets:
    - terminal
    - code_execution
    - file
    - browser
    - computer_use
    - web
    - vision
    - image_gen
    - video
    - video_gen
    - bfl
    - stt
    - tts
    - messaging
    - cronjob
    - delegation
    - skills
    - memory
    - context_engine
    - session_search
    - kanban
    - project
    - desktop_ui
    - homeassistant
    - x_search

memory:
  memory_enabled: false
  user_profile_enabled: {{STATIC_PERSONALIZATION_ENABLED}}

context:
  engine: compressor

hooks: []
hooks_auto_accept: false
quick_commands: {}

# The baseline approved model-tool list is `clarify` only. `/help` and `/whoami`
# are gateway commands, not model tools. Run the current Hermes resolver against
# this exact production configuration. Any other resolved tool is a failure.
#
# This fragment does not reject inbound media. Current Hermes can transcribe or
# route media before the model tool loop. Use a tested adapter, proxy, or platform
# control that rejects image, voice, audio, video, and document input before
# Hermes receives or downloads it. Otherwise a text-only deployment is FAIL.
